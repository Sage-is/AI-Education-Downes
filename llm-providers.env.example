# Example LLM Configurations for Different Providers
# Copy the relevant section to your .env file

# ============================================================
# OPTION 1: OpenAI (Recommended for Production)
# ============================================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
LLM_MODEL=gpt-4o  # or gpt-4-turbo, gpt-3.5-turbo
LLM_TEMPERATURE=0

# ============================================================
# OPTION 2: OpenRouter (Access 100+ Models with One API Key)
# ============================================================
# Get API key from: https://openrouter.ai/keys
# Browse models: https://openrouter.ai/models
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet  # or meta-llama/llama-3.1-405b, google/gemini-pro-1.5, etc.
LLM_TEMPERATURE=0

# ============================================================
# OPTION 3: Ollama (100% Free Local Models)
# ============================================================
# 1. Install Ollama: https://ollama.ai
# 2. Pull a model: ollama pull llama3.2
# 3. Ollama will run on localhost:11434
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2  # or mistral, qwen2.5, phi3, etc.
OPENAI_API_KEY=not-needed-for-local
LLM_TEMPERATURE=0

# Popular Ollama models:
# - llama3.2:latest (3B/1B - fast, good for testing)
# - llama3.1:70b (best quality, needs powerful GPU)
# - mistral:latest (7B - good balance)
# - qwen2.5:latest (Chinese + English)
# - deepseek-coder:latest (good for code)

# ============================================================
# OPTION 4: llama.cpp Server (100% Free Local Models)
# ============================================================
# 1. Download llama.cpp from: https://github.com/ggerganov/llama.cpp
# 2. Start server: ./llama-server -m your-model.gguf --port 8080
OPENAI_BASE_URL=http://localhost:8080/v1
LLM_MODEL=your-model-name
OPENAI_API_KEY=not-needed-for-local
LLM_TEMPERATURE=0

# ============================================================
# OPTION 5: Sage.is (Privacy-Focused Cloud LLMs)
# ============================================================
# Get API key from: https://sage.is
OPENAI_API_KEY=your-sage-api-key
OPENAI_BASE_URL=https://api.sage.is/v1
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0

# ============================================================
# OPTION 6: Together.ai (Fast Cloud Inference)
# ============================================================
# Get API key from: https://together.ai
OPENAI_API_KEY=your-together-api-key
OPENAI_BASE_URL=https://api.together.xyz/v1
LLM_MODEL=meta-llama/Meta-Llama-3.1-405B-Instruct-Turbo
LLM_TEMPERATURE=0

# ============================================================
# OPTION 7: Anyscale Endpoints (Scalable LLM Serving)
# ============================================================
# Get API key from: https://anyscale.com
OPENAI_API_KEY=your-anyscale-api-key
OPENAI_BASE_URL=https://api.endpoints.anyscale.com/v1
LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
LLM_TEMPERATURE=0

# ============================================================
# OPTION 8: LM Studio (Local GUI for Running Models)
# ============================================================
# 1. Download LM Studio: https://lmstudio.ai
# 2. Download a model through the UI
# 3. Start local server (default port 1234)
OPENAI_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model  # Name from LM Studio
OPENAI_API_KEY=not-needed-for-local
LLM_TEMPERATURE=0

# ============================================================
# OPTION 9: vLLM (High-Performance Local Serving)
# ============================================================
# 1. Install vLLM: pip install vllm
# 2. Start server: python -m vllm.entrypoints.openai.api_server --model meta-llama/Llama-3.1-8B-Instruct
OPENAI_BASE_URL=http://localhost:8000/v1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
OPENAI_API_KEY=not-needed-for-local
LLM_TEMPERATURE=0

# ============================================================
# OPTION 10: Azure OpenAI
# ============================================================
# Note: Azure OpenAI has different endpoint structure
# You may need to use langchain_openai.AzureChatOpenAI directly
# or adapt the model.py file for Azure-specific format
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
OPENAI_API_VERSION=2024-02-15-preview

# ============================================================
# Performance Tips
# ============================================================

# For local models (Ollama, llama.cpp):
# - Smaller models (3B-7B) work well for most tasks
# - Larger models (70B+) give better quality but need powerful hardware
# - Quantized models (Q4, Q5) balance quality and speed

# For cloud providers:
# - OpenAI GPT-4: Best quality, most expensive
# - OpenRouter: Access to many models with one key
# - Together.ai/Anyscale: Fast inference, good pricing
# - Local: Free but slower, requires good hardware

# Temperature:
# - 0 = Most deterministic (recommended for financial analysis)
# - 0.5-0.7 = More creative
# - 1.0 = Most random
