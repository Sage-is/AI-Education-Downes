# LLM Configuration
# The agent works with OpenAI and any OpenAI-compatible API

# OpenAI API Key (required for OpenAI, OpenRouter, etc.)
OPENAI_API_KEY=your-openai-api-key

# OPTIONAL: Model name (default: gpt-4.1)
# Examples:
# - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# - OpenRouter: anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-405b
# - Ollama: llama3.2, mistral, qwen2.5
# LLM_MODEL=gpt-4.1

# OPTIONAL: Temperature (default: 0)
# LLM_TEMPERATURE=0

# OPTIONAL: Custom API base URL for OpenAI-compatible APIs
# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Ollama example (local):
# OPENAI_BASE_URL=http://localhost:11434/v1
# llama.cpp example (local):
# OPENAI_BASE_URL=http://localhost:8080/v1
# sage.is example:
# OPENAI_BASE_URL=https://api.sage.is/v1
# OPENAI_BASE_URL=

# Data Provider Configuration (OPTIONAL)
# By default, the agent uses FREE data sources (Yahoo Finance, SEC EDGAR)
# No API keys required for basic functionality!

# OPTIONAL: If you want to use Financial Datasets API (paid service)
# Uncomment the line below and add your key from https://financialdatasets.ai
# FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# OPTIONAL: Specify which data provider to use
# Options: 'yahoo' (free, default), 'sec' (free, filings only), 'financial_datasets' (paid)
# If not set, will auto-select based on available API keys (defaults to 'yahoo')
# DATA_PROVIDER=yahoo

# OPTIONAL: For SEC EDGAR access, provide contact info (required by SEC)
# SEC_USER_AGENT=YourCompany contact@example.com

# LangSmith (OPTIONAL - for tracing and debugging)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=downes
LANGSMITH_TRACING=true