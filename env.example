# LLM Configuration
# The agent works with OpenAI and any OpenAI-compatible API

# OpenAI API Key (required for OpenAI, OpenRouter, etc.)
OPENAI_API_KEY=your-openai-api-key

# OPTIONAL: Model name (default: gpt-4.1)
# Examples:
# - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# - OpenRouter: anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-405b
# - Ollama: llama3.2, mistral, qwen2.5
# LLM_MODEL=gpt-4.1

# OPTIONAL: Temperature (default: 0)
# LLM_TEMPERATURE=0

# OPTIONAL: Custom API base URL for OpenAI-compatible APIs
# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Ollama example (local):
# OPENAI_BASE_URL=http://localhost:11434/v1
# llama.cpp example (local):
# OPENAI_BASE_URL=http://localhost:8080/v1
# sage.is example:
# OPENAI_BASE_URL=https://api.sage.is/v1
# OPENAI_BASE_URL=



# LangSmith (OPTIONAL - for tracing and debugging)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=downes
LANGSMITH_TRACING=true

# SearXNG (OPTIONAL - for broader education/OER search)
# Set to your SearXNG instance base URL to enable the searx_search tool
# Example public instance (subject to change): https://searx.tiekoetter.com
# SEARXNG_INSTANCE_URL=