# Hidden-artifact allowlist: deny dotfiles and dotfolders everywhere in the
# repo unless they are intentionally shared and explicitly included below.
.*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.editorconfig
!/.todoscope-exclude.csv
# Security hooks MUST be tracked. AI-UI lost all five hook stages to exactly
# this rule: `.githooks/` was never in git, so `core.hooksPath` pointed at a
# directory that did not exist on a fresh clone and every gate was silently
# inert. Removing these two lines disables the hooks for everyone but you.
!/.pre-commit-config.yaml
!/.gitleaks.toml
!/studio/.downes/
!/studio/.downes/**
!/.github/
!/.github/**
# push to its own remote; not vendored into this AGPL repo. See
# docs/fork-brand-surface.md.
# Claude Code project settings are shared; settings.local.json stays local.
!/.claude/
!/.claude/settings.json
# *.example at any depth (no leading slash). Keep this note on its OWN line —
# gitignore has no inline comments; a trailing comment becomes part of the pattern.
!.*.example

# Non-dot build & runtime junk (root-anchored so vendored sub-repos keep their own)
__pycache__/
*.py[cod]
*$py.class
*.so
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
*.egg
venv/
env/
ENV/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.swp
*.swo
*~

# User data: generated curriculum runs. Never committed; the README is.
vault/*
!vault/README.md
# Deny ONLY courses/, not all of studio/.downes/. The rest of that folder --
# METHOD.md, prompts/, skills/ -- is the shipped payload: package_macos.sh
# rsyncs studio/ into every release and excludes just .downes/courses/. A
# blanket `studio/.downes/` rule hid the whole payload from git, so a 9th skill
# would never be offered at commit time and a fresh clone would build a Downes
# without it. Keep this narrow.
studio/.downes/courses/

# Internal-only docs: design-review narration, reviewer commentary, draft
# copy, anything with named opinions or unshipped positions. Never committed.
# Every repo is version-backed-up and synced independently of git, so the team
# still receives this folder in full — git simply is not the channel for it.
# Convention: docs/internal-docs.md. NOTE: this rule silently ignores NEW
# files under docs/dossiers/ — that is intentional here, but it means a file
# put there will never prompt you at commit time.
docs/dossiers/
