# Hidden-artifact allowlist: deny dotfiles and dotfolders everywhere in the
# repo unless they are intentionally shared and explicitly included below.
.*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.todoscope-exclude.csv
!/studio/.downes/
!/studio/.downes/**
!/.github/
!/.github/**
# The ai-ui-mini fork keeps its own git history (branch downes/v1) and will
# push to its own remote; not vendored into this AGPL repo. See
# docs/fork-brand-surface.md.
/ai-ui-mini/
# Claude Code project settings are shared; settings.local.json stays local.
!/.claude/
!/.claude/settings.json
# *.example at any depth (no leading slash). Keep this note on its OWN line —
# gitignore has no inline comments; a trailing comment becomes part of the pattern.
!.*.example

# Non-dot build & runtime junk (root-anchored so vendored sub-repos keep their own)
__pycache__/
*.py[cod]
*$py.class
*.so
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
*.egg
venv/
env/
ENV/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.swp
*.swo
*~

# User data: generated curriculum runs. Never committed; the README is.
vault/*
!vault/README.md
studio/.downes/
